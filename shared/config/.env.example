# Citation-Aware Medical RAG - Environment Configuration

# Required: Google API Key for LLM Citation Extraction (THE CORE FEATURE)
GOOGLE_API_KEY=your_google_api_key_here

# Optional: Pinecone for Vector Storage
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=medical-rag-index
PINECONE_NAMESPACE=thera-rag

# Optional: Google Sheets Logging
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id
GOOGLE_SHEETS_CREDS_JSON=path_to_service_account.json

# RAG Configuration
LLM_MODEL=gemini-1.5-flash
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4000
RETRIEVAL_K=15

# Citation Extraction Settings
ENABLE_LLM_CITATIONS=true
CITATION_CONFIDENCE_THRESHOLD=0.5

# Processing Settings
CHUNK_SIZE=3000
CHUNK_OVERLAP=300
PRESERVE_FULL_CONTENT=true